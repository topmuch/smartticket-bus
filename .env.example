# ============================================
# SmartTicket Bus - Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# Database (SQLite) - defaults to /app/data/smartticket.db in Docker
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# JWT Authentication
JWT_SECRET="change-me-generate-with-crypto-randombytes-32"
JWT_REFRESH_SECRET="change-me-generate-with-crypto-randombytes-32"

# QR Code Signing
QR_SIGNING_SECRET="change-me-generate-with-crypto-randombytes-32"

# App Config
NEXT_PUBLIC_APP_NAME="SmartTicket Bus"
NEXT_PUBLIC_API_URL="/api"

# Server
PORT=3000
HOSTNAME="0.0.0.0"
NODE_ENV="production"
